#!/bin/sh
# Starts the Zapret window. UTF-8 is set here so file names with Russian letters work even under the "C" locale
# (menu entries and autostart often start programs with no locale at all).
export PYTHONUTF8=1
# The compiled program ignores PYTHONUTF8; its file-name and text encoding follow the C library's character type.
export LC_CTYPE=C.UTF-8
exec /opt/zapretgui/_internal/zapretgui "$@"
